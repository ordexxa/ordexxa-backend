# OrDexxa Backend - variables de entorno de ejemplo

# Este archivo SI se puede versionar.

# No colocar secretos reales en este archivo.

# Para uso real, copiar como .env y completar los valores privados.

SERVER_PORT=8081

# Base de datos local

DB_URL=jdbc:postgresql://localhost:5433/ordexxa_db
DB_USERNAME=ordexxa_user
DB_PASSWORD=ordexxa_password

# SMTP local por defecto con Mailpit

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_TRUST=*
MAIL_FROM=no-reply@ordexxa.local

# SMTP real con SendGrid

# Usar estos valores en .env local privado o en Render.

# No subir la API Key real a Git.

# MAIL_HOST=smtp.sendgrid.net

# MAIL_PORT=587

# MAIL_USERNAME=apikey

# MAIL_PASSWORD=TU_API_KEY_DE_SENDGRID

# MAIL_SMTP_AUTH=true

# MAIL_SMTP_STARTTLS=true

# MAIL_SMTP_STARTTLS_REQUIRED=true

# MAIL_SMTP_SSL_TRUST=smtp.sendgrid.net

# MAIL_FROM=TU_CORREO_REMITENTE_VERIFICADO

AUTH_CODE_EXPIRATION_MINUTES=15
AUTH_SHOW_CODE_IN_CONSOLE=false

# JPA / Hibernate
# Para local se puede usar update.
# Para nube/productivo se recomienda validate o none después de tener migraciones.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Swagger / OpenAPI
# En local puede estar activo.
# En nube/productivo puede desactivarse cambiando estos valores a false.
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_SHOW_ACTUATOR=true

# Actuator / Monitoring
# Prometheus queda expuesto para futura integración con Grafana/Prometheus.
ACTUATOR_EXPOSURE_INCLUDE=health,info,metrics,prometheus
ACTUATOR_HEALTH_SHOW_DETAILS=always
ACTUATOR_INFO_ENV_ENABLED=true

# CORS
# Separar múltiples orígenes con coma.
# Ejemplo nube: https://ordexxa-frontend.vercel.app,https://ordexxa-gateway.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4173

# Cache / Redis
# En local usar Redis instalado por Homebrew o Docker.
CACHE_TYPE=redis
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT=2s
REDIS_REPOSITORIES_ENABLED=false
CACHE_TTL=30m
CACHE_KEY_PREFIX=ordexxa::
ACTUATOR_REDIS_HEALTH_ENABLED=true

# Redis en nube
# En proveedores como Upstash o Redis Cloud normalmente se usa una URL segura rediss://
# REDIS_URL=<URL_REDIS_SEGURA_DEL_PROVEEDOR>

